{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    /*
     * core/ runs under `node --experimental-strip-types`, so its imports carry
     * explicit `.ts` extensions. Consuming `@echo/core/wire` pulls that graph
     * into this typecheck, and without this flag every one of those imports is
     * an error in a file we don't own. Safe here precisely because `noEmit` is
     * on — we type-check core/'s sources, we never compile them.
     */
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@echo/core/vocabulary": [
        "../core/src/api/vocabulary.ts"
      ],
      "@echo/core/wire": [
        "../core/src/api/wire.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-gate/types/**/*.ts",
    ".next-gate/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
