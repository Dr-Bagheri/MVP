# Secrets — never in the repo
.env
.env.*
# ...except the templates, which carry names and defaults but never values.
!.env.example
!*/.env.example
*.token
*.secret
secrets/
*.jks
*.keystore
keystore.properties

# Local-only documents
*.docx
docs/*.pdf
# ...and the pipeline that builds them: a working tool, not a repo deliverable.
docs/blueprint-src/

# Node / TypeScript
node_modules/
dist/
.next/
# the build gate's own output dir — kept separate so it cannot corrupt the
# shared dev server's .next (see web/scripts/build-gate.mjs)
.next-gate/
.next-m30-gate/
*.tsbuildinfo

# Supabase CLI state
**/supabase/.temp/

# ML models cache (large ONNX files fetched at setup)
ml/models/

# WER reference transcripts: real recordings' content, corrected by hand.
# Kept out of the repo like any other recording content.
ml/test/wer/refs/

# Backup copies of config
*.bak
local.properties*

# OS / editor noise
Thumbs.db
.DS_Store
.idea/
.vercel
.env*

# machine-move staging must never live in the tree (a private key sat here 2026-08-25)
/ssh/
/repo-local/
