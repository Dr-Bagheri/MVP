{
  "name": "@echo/ml",
  "version": "0.1.0",
  "private": true,
  "description": "Echo speech facade — audio in, words + speakers out. Productless: no DB, no identity.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx test/smoke/persian-live.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.11.3",
    "onnxruntime-node": "^1.27.0",
    "pino": "^9.6.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
