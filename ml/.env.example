# ml/ — the speech facade. Copy to .env.local (git-ignored) and fill in.
#
# ml/ is PRODUCTLESS (Invariant 6): it holds its OWN upstream keys and nothing
# else. No DATABASE_URL, no SUPABASE_*, no product JWT belongs in this file —
# if one appears here, the caller has a bug, not a configuration need.

ML_PORT=7801
ML_HOST=127.0.0.1
ML_LOG_LEVEL=info

# --- upstream keys (real values live in the operator's secret store) ---------
SONIOX_API_KEY=
OPENROUTER_API_KEY=

# Attempt order. Soniox is the only lane that delivers word-level timestamps.
ML_LANE_ORDER=soniox,openrouter

# M6 ruling: degrade-and-flag, in EVERY deployment profile. 0 = a lane that
# cannot carry timings still returns a transcript, flagged `degraded` with
# timestamps:"none" in provenance, so a call is never lost.
#
# 1 = refuse the job instead. Sanctioned ONLY for CI and acceptance runs, where
# a contract regression should fail loudly rather than degrade quietly. Do not
# set it in a deployment — it turns a degraded call into a lost one.
ML_REQUIRE_WORD_TIMESTAMPS=0

# --- audio sources ----------------------------------------------------------
# Local dev (M12.1) reads files off disk. In cloud/on-prem this stays 0 and
# audio arrives as a pre-signed URL instead.
ML_ALLOW_LOCAL_PATHS=0

# Hosts a pre-signed audio_url may point at. Empty in production means NO url
# source is configured — not "any host is fine".
ML_URL_ALLOWLIST=

ML_MAX_DURATION_MS=2100000
ML_MAX_BYTES=524288000
# ML_WORK_DIR=

# --- tools and models -------------------------------------------------------
# ffmpeg is resolved from PATH unless these are set. Not vendored: container
# images install it (M12.2/3).
# ML_FFMPEG_PATH=
# ML_FFPROBE_PATH=

# silero_vad.onnx. Without it, silence trimming falls back to an energy gate,
# which is weaker and therefore sends more paid audio to the STT.
# ML_SILERO_MODEL=

# Local diarization (M6), via sherpa-onnx. Needed only for mono audio on a lane
# that does not diarize — Soniox does, and two-channel audio never needs it.
# Absent models = no diarizer, which degrades that one path rather than failing.
ML_DIARIZER=auto
# ML_SEGMENTATION_MODEL=models/segmentation.onnx
# ML_EMBEDDING_MODEL=models/embedding.onnx

# Measured, not guessed: 4 threads beat 8 on the spike box (oversubscription).
# Do NOT auto-set this from core count. Re-measure on the deployment box — the
# same file swung 6x under CPU contention.
ML_DIARIZER_THREADS=4
# M6 requires this tunable. 0.5 is what was validated, not a universal truth.
ML_DIARIZER_THRESHOLD=0.5

ML_STT_TIMEOUT_MS=900000
ML_STT_POLL_MS=3000
