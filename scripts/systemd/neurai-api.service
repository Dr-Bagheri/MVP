[Unit]
Description=NeurAI core api (:8080)
After=network-online.target
Wants=network-online.target
[Service]
User=neurai
Group=neurai
WorkingDirectory=/opt/neurai/app/core
EnvironmentFile=/etc/neurai/core.env
ExecStart=/usr/bin/node --experimental-strip-types src/api/main.ts
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
